# OpenConvert Environment Variables
# Copy this file to .env and fill in values as needed.

# Tauri updater signing (required for production releases)
# Generate with: npx tauri signer generate -w ~/.tauri/openconvert.key
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Vite environment variables (prefixed with VITE_)
# VITE_APP_TITLE=OpenConvert
