{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenConvert",
  "version": "0.1.0",
  "identifier": "dev.sparshsam.openconvert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenConvert",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Sparsh Sam",
    "shortDescription": "Fast, local-first image conversion for Windows.",
    "longDescription": "OpenConvert is a bright, roomy, local-first Windows image converter. Files never leave your computer.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"],
        "sidebarImage": null,
        "headerImage": null
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRkMzMDgxMjFERURGQkUKUldTKzM5NGhnVEQ4bnJONDlJakhTWXVYQUx2RHdYVk5uVkNoWXZVd08vWG01Rm1CcWlWOCt2blMK",
      "endpoints": [
        "https://github.com/sparshsam/OpenConvert/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
